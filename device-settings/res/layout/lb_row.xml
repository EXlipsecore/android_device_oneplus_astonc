<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="0dp"
    android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/lb_ic" android:layout_width="20dp" android:layout_height="20dp" android:alpha="0.86" />
  <TextView android:id="@+id/lb_lb" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="6dp" android:textColor="#DCFFFFFF" android:textSize="13dp" />
  <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
  <TextView android:id="@+id/lb_ex" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginEnd="6dp" android:textColor="#B0FFFFFF" android:textSize="13dp" />
  <TextView android:id="@+id/lb_vl" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#FFFFFFFF" android:textSize="15dp" android:textStyle="bold" />
</LinearLayout>
